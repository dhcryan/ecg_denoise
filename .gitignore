###############################
# Global ignore everything by default
###############################
/*

###############################
# Allow the minimal Dual_FreqDAE repository and git metadata
###############################
!/.gitignore
!/.git/**
!/dual_freqdae_repo
!/dual_freqdae_repo/**
!/README.md

###############################
# Inside the minimal repo keep all by default (no overrides)
###############################

###############################
# Ignore large binary / intermediate artifacts inside minimal repo if produced later
###############################
dual_freqdae_repo/**/*.ipynb_checkpoints/*
dual_freqdae_repo/**/*.pyc
dual_freqdae_repo/**/__pycache__/*
dual_freqdae_repo/**/runs_*/*
dual_freqdae_repo/**/cache/*
dual_freqdae_repo/**/tmp/*
dual_freqdae_repo/**/logs/*
dual_freqdae_repo/**/figures/*
dual_freqdae_repo/**/*.pkl

###############################
# Keep empty data directory placeholder
###############################
!dual_freqdae_repo/data/.gitkeep

###############################
# Optional model weight patterns (if you don't want to track future retrains)
###############################
# dual_freqdae_repo/**/Dual_FreqDAE_weights.best.weights.h5
# dual_freqdae_repo/**/*.h5
# dual_freqdae_repo/**/*.hdf5

###############################
# Allow docs and README always
###############################
!dual_freqdae_repo/README.md
!dual_freqdae_repo/docs/**